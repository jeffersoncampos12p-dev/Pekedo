-- Theme colors
local Dark = {
    Bg = "#151515", Side = "#141414", Elem = "#181818",
    Hov = "#222222", Text = "#ffffff", Sub = "#dddddd", Acc = "#ffffff",
}
local Light = {
    Bg = "#f0f0f0", Side = "#e0e0e0", Elem = "#ffffff",
    Hov = "#dddddd", Text = "#000000", Sub = "#333333", Acc = "#000000",
}
local C = Dark

local function applyTheme(themeName)
    C = (themeName == "Light") and Light or Dark
    local function map(hex)
        if hex == Dark.Bg then return C.Bg elseif hex == Dark.Side then return C.Side
        elseif hex == Dark.Elem then return C.Elem elseif hex == Dark.Hov then return C.Hov
        elseif hex == Dark.Text then return C.Text elseif hex == Dark.Sub then return C.Sub
        elseif hex == Dark.Acc then return C.Acc end
        return hex
    end
    local function update(obj)
        if obj:IsA("Frame") or obj:IsA("TextButton") then
            pcall(function() obj.BackgroundColor3 = Color3.fromHex(map("#"..string.format("%02x%02x%02x",math.floor(obj.BackgroundColor3.R*255),math.floor(obj.BackgroundColor3.G*255),math.floor(obj.BackgroundColor3.B*255)))) end)
        end
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            pcall(function() obj.TextColor3 = Color3.fromHex(map("#"..string.format("%02x%02x%02x",math.floor(obj.TextColor3.R*255),math.floor(obj.TextColor3.G*255),math.floor(obj.TextColor3.B*255)))) end)
        end
        if obj:IsA("ImageLabel") then
            pcall(function() obj.ImageColor3 = Color3.fromHex(map("#"..string.format("%02x%02x%02x",math.floor(obj.ImageColor3.R*255),math.floor(obj.ImageColor3.G*255),math.floor(obj.ImageColor3.B*255)))) end)
        end
        if obj:IsA("UIStroke") then
            pcall(function() obj.Color = Color3.fromHex(map("#"..string.format("%02x%02x%02x",math.floor(obj.Color.R*255),math.floor(obj.Color.G*255),math.floor(obj.Color.B*255)))) end)
        end
        for _, child in ipairs(obj:GetChildren()) do update(child) end
    end
    update(Main)
    update(ToggleBtn)
end

-- Helper to create an icon
local function addIcon(parent, iconName, size, posX, posY, color)
    local id = getIcon(iconName)
    if id then
        local img = Instance.new("ImageLabel")
        img.Size = UDim2.new(0, size, 0, size)
        img.Position = UDim2.new(0, posX, 0.5, -size/2)
        img.BackgroundTransparency = 1
        img.Image = id
        img.ImageColor3 = color or Color3.fromHex(C.Text)
        img.ScaleType = Enum.ScaleType.Fit
        img.Parent = parent
        return img
    end
    return nil
end

-- Helper to add UIStroke border
local function addBorder(obj, color)
    local s = Instance.new("UIStroke", obj)
    s.Color = color or Color3.fromHex(C.Hov)
    s.Thickness = 1
end

