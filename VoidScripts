-- Loop principal
RunService.RenderStepped:Connect(function()
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChild("Humanoid")
    local hr = c:FindFirstChild("HumanoidRootPart")

    if States.Noclip then for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    if States.Fly and hr then
        local bv = hr:FindFirstChild("FlyV")
        local bg = hr:FindFirstChild("FlyG")
        if bv and bg then
            local d = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then d += Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then d -= Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then d -= Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then d += Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then d -= Vector3.new(0, 1, 0) end
            bv.Velocity = (d.Magnitude > 0 and d.Unit or Vector3.zero) * States.FlySpeed
            bg.CFrame = CFrame.new(Vector3.zero, Camera.CFrame.LookVector)
        end
    end
    if States.BunnyHop and h and h.MoveDirection.Magnitude > 0 then h.Jump = true end
    if States.SpinBot and hr then hr.CFrame = hr.CFrame * CFrame.Angles(0, math.rad(10), 0) end
    if States.Fling and hr then hr.Velocity = hr.CFrame.LookVector * States.FlingPower; hr.RotVelocity = Vector3.new(math.random(-20,20), math.random(-20,20), math.random(-20,20)) end
    if States.Invisible then for _, p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.Transparency = 0.7 end end end
    if States.GodMode or States.ForceField then
        if h and h.Health < h.MaxHealth then h.Health = h.MaxHealth end
    elseif States.AutoHeal and h and h.Health < h.MaxHealth then
        h.Health = math.min(h.Health + States.HealAmount * 0.02, h.MaxHealth)
    end
    if States.ForceField then
        if not c:FindFirstChildOfClass("ForceField") then Instance.new("ForceField", c) end
    else
        local ff = c:FindFirstChildOfClass("ForceField")
        if ff then ff:Destroy() end
    end
    if States.Freecam then
        if h then h.AutoRotate = false end
        Camera.CameraSubject = nil
    else
        if h then h.AutoRotate = true end
        if not States.Spectate then Camera.CameraSubject = h end
    end
    if States.Spectate and States.Spectate.Character then
        local t = States.Spectate.Character:FindFirstChild("Head")
        if t then Camera.CameraSubject = t end
    end
    if States.Fullbright then
        Lighting.Ambient = Color3.new(1,1,1); Lighting.OutdoorAmbient = Color3.new(1,1,1)
    else
        Lighting.Ambient = Color3.new(0,0,0); Lighting.OutdoorAmbient = Color3.new(0.5,0.5,0.5)
    end
    if States.Zoom then Camera.FieldOfView = States.ZoomAmount end
    if States.Aimbot and c then
        local n = nil; local md = 200
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then
                local d = (Camera.CFrame.Position - p.Character.Head.Position).Magnitude
                if d < md then md = d; n = p.Character.Head end
            end
        end
        if n then Camera.CFrame = CFrame.new(Camera.CFrame.Position, n.Position) end
    end
    -- Munição infinita
    if States.InfAmmo then
        local tools = {}
        if LocalPlayer.Backpack then for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end end
        if c then for _, t in ipairs(c:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end end
        for _, tool in ipairs(tools) do
            for _, attr in ipairs({"Ammo", "CurrentAmmo", "Magazine", "Clip", "Bullets"}) do
                local obj = tool:FindFirstChild(attr)
                if obj and obj:IsA("IntValue") then obj.Value = 999999999 end
                if obj and obj:IsA("NumberValue") then obj.Value = 999999999 end
            end
        end
    end
end)

