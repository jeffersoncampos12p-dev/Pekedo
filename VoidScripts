    if States.Wireframe then for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.Wireframe = true end end end
    if States.XRay then for _, v in ipairs(Workspace:GetDescendants()) do if v:IsA("BasePart") and v.Transparency < 0.5 then v.Transparency = 0.8 end end end
    if States.AntiFall and hrp and hrp.Velocity.Y < -50 then hrp.Velocity = Vector3.new(0, 0, 0) end
    if States.InfiniteJump and humanoid then humanoid.Jump = true end
    if States.SlowFall and hrp then hrp.Velocity = hrp.Velocity * Vector3.new(1, 0.5, 1) end
    if States.NoSlow and humanoid then humanoid.WalkSpeed = math.max(humanoid.WalkSpeed, 32) end
    if States.BodyThrust and hrp then hrp.Velocity = hrp.Velocity + Camera.CFrame.LookVector * States.ThrustPower * 0.1 end
    if States.AntiGravity then Workspace.Gravity = -50 end
    if States.Magneto and hrp then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj:IsDescendantOf(Workspace) then
                local dist = (hrp.Position - obj.Position).Magnitude
                if dist < 50 then obj.Velocity = (hrp.Position - obj.Position).Unit * States.MagnetoForce end
            end
        end
    end
    if States.Tornado and hrp then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local otherHrp = plr.Character.HumanoidRootPart
