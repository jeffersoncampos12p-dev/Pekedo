-- Sistema de comandos
local function ParseCommand(cmd)
    cmd = cmd:lower()
    local args = {}
    for word in cmd:gmatch("%S+") do table.insert(args, word) end
    if #args == 0 then return end

    local command = args[1]
    local value = tonumber(args[2]) or args[2]

    -- Mapeamento de comandos (será expandido nas próximas partes)
    if command == "fly" then
        States.Fly = value == "on" or value == true
    elseif command == "noclip" then
        States.Noclip = value == "on" or value == true
    elseif command == "speed" and tonumber(args[2]) then
        States.WalkSpeed = tonumber(args[2])
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = tonumber(args[2])
        end
    elseif command == "god" then
        States.GodMode = value == "on" or value == true
    elseif command == "forcefield" then
        States.ForceField = value == "on" or value == true
    elseif command == "heal" then
        States.AutoHeal = value == "on" or value == true
    elseif command == "fov" and tonumber(args[2]) then
        States.FOV = tonumber(args[2])
        Camera.FieldOfView = tonumber(args[2])
    elseif command == "time" and tonumber(args[2]) then
        States.Time = tonumber(args[2])
        Lighting:SetMinutesAfterMidnight(tonumber(args[2]) * 60)
    elseif command == "gravity" and tonumber(args[2]) then
        States.Gravity = tonumber(args[2])
        Workspace.Gravity = tonumber(args[2])
    elseif command == "fullbright" then
        States.Fullbright = value == "on" or value == true
    elseif command == "invisible" then
        States.Invisible = value == "on" or value == true
    elseif command == "freecam" then
        States.Freecam = value == "on" or value == true
    elseif command == "zoom" and tonumber(args[2]) then
        States.ZoomAmount = tonumber(args[2])
    elseif command == "esp" then
        States.ESP_Players = value == "on" or value == true
    elseif command == "aimbot" then
        States.Aimbot = value == "on" or value == true
    elseif command == "rejoin" then
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    elseif command == "serverhop" then
        TeleportService:TeleportToPlaceInstance(game.PlaceId, TeleportService:GetPlayerPlaceInstanceAsync(game.PlaceId))
    end
    -- Muitos outros comandos serão adicionados nas partes 2-4
end

