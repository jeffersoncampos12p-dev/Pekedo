end

local function PlayPhonk()
    if S.AuraSound then S.AuraSound:Destroy() end
    local sound = Instance.new("Sound", LocalPlayer.PlayerGui)
    sound.SoundId = "rbxassetid://1842802021"
    sound.Volume = 0.8
    sound.Looped = true
    sound:Play()
    S.AuraSound = sound
end

-- Cria uma parte ancorada no jogador (visível a todos)
local function AttachPart(name, size, color, transparency)
    local part = Instance.new("Part")
    part.Name = "AuraPart_" .. name
    part.Size = size or Vector3.new(1, 1, 1)
    part.Anchored = true
    part.CanCollide = false
    part.Material = Enum.Material.Neon
    part.Color = color
    part.Transparency = transparency or 0.5
    part.Parent = Workspace
    table.insert(S.AuraParts, part)
    return part
end

local function ApplyReplicatedAura(v, name, color, useFire, useSparkles, particleTexture, rate, lifetime, size, speed, acceleration)
    ClearAuras()
    if not v then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local part = AttachPart(name, Vector3.new(0.5, 0.5, 0.5), color, 0.9)
    if useFire then
        local fire = Instance.new("Fire", part); fire.Heat = 25; fire.Size = 15; fire.Color = color
    elseif useSparkles then
        local spark = Instance.new("Sparkles", part); spark.SparkleColor = color
    elseif particleTexture then
        local emitter = Instance.new("ParticleEmitter", part)
        emitter.Texture = particleTexture
        emitter.Color = ColorSequence.new(color)
        emitter.Rate = rate or 50
        emitter.Lifetime = lifetime or NumberRange.new(1, 2)
        emitter.Size = size or NumberSequence.new(1.5)
        emitter.Speed = speed or NumberRange.new(1, 3)
        if acceleration then emitter.Acceleration = acceleration end
    end
    AddLight(color, 20, 5)
end

local function ApplySwordAura(v)
    ClearAuras()
    if not v then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local parts = {}
    for i = 1, 8 do
        local angle = (i-1)*(math.pi*2/8)
        local sword = Instance.new("Part")
        sword.Name = "AuraSword"; sword.Size = Vector3.new(0.2,0.2,3); sword.Anchored = true; sword.CanCollide = false
        sword.Material = Enum.Material.Metal; sword.Color = Color3.fromRGB(255,215,0); sword.Transparency = 0.3; sword.Parent = Workspace
        local handle = Instance.new("Part", sword)
        handle.Size = Vector3.new(0.3,0.3,1); handle.CanCollide = false; handle.Anchored = true
        handle.Material = Enum.Material.Metal; handle.Color = Color3.fromRGB(139,69,19); handle.Transparency = 0.3
        table.insert(parts, {sword = sword, angle = angle})
    end
    S.SwordParts = parts
    AddLight(Color3.fromRGB(255,215,0), 25, 6)
end

local function ApplyWeaponOrbit(v, name, count, size, color)
    ClearAuras()
    if not v then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local parts = {}
    for i = 1, count do
        local angle = (i-1)*(math.pi*2/count)
        local part = Instance.new("Part")
        part.Name = "Aura"..name; part.Size = size; part.Anchored = true; part.CanCollide = false
        part.Material = Enum.Material.Metal; part.Color = color; part.Transparency = 0.2; part.Parent = Workspace
        table.insert(parts, {part = part, angle = angle})
    end
    if not S.WeaponParts then S.WeaponParts = {} end
    for _, p in ipairs(parts) do table.insert(S.WeaponParts, p) end
    AddLight(color, 20, 5)
end

