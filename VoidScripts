local function CreateToggle(name, icon, callback)
    local ToggleFrame = Instance.new("TextButton")
    ToggleFrame.Size = UDim2.new(1, -20, 0, 48)
    ToggleFrame.BackgroundColor3 = Color3.fromHex("#181818")
    ToggleFrame.BorderSizePixel = 0
    ToggleFrame.Text = ""
    ToggleFrame.AutoButtonColor = false
    ToggleFrame.Parent = ScrollFrame
    Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 12)

    local InfoFrame = Instance.new("Frame", ToggleFrame)
    InfoFrame.Size = UDim2.new(1, -70, 1, 0)
    InfoFrame.Position = UDim2.new(0, 12, 0, 0)
    InfoFrame.BackgroundTransparency = 1

    local IconLabel = Instance.new("TextLabel", InfoFrame)
    IconLabel.Size = UDim2.new(0, 24, 1, 0)
    IconLabel.BackgroundTransparency = 1
    IconLabel.Text = icon
    IconLabel.TextSize = 18
    IconLabel.TextColor3 = Color3.fromHex("#ffffff")
    IconLabel.Font = Enum.Font.Gotham

    local NameLabel = Instance.new("TextLabel", InfoFrame)
    NameLabel.Size = UDim2.new(1, -30, 1, 0)
    NameLabel.Position = UDim2.new(0, 30, 0, 0)
    NameLabel.BackgroundTransparency = 1
    NameLabel.Text = name
    NameLabel.TextColor3 = Color3.fromHex("#ffffff")
    NameLabel.TextSize = 15
    NameLabel.Font = Enum.Font.Gotham
    NameLabel.TextXAlignment = Enum.TextXAlignment.Left

    local SwitchFrame = Instance.new("Frame", ToggleFrame)
    SwitchFrame.Size = UDim2.new(0, 44, 0, 24)
    SwitchFrame.Position = UDim2.new(1, -56, 0.5, -12)
    SwitchFrame.BackgroundColor3 = Color3.fromHex("#222222")
    SwitchFrame.BorderSizePixel = 0
    Instance.new("UICorner", SwitchFrame).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame", SwitchFrame)
    Knob.Size = UDim2.new(0, 20, 0, 20)
    Knob.Position = UDim2.new(0, 2, 0.5, -10)
    Knob.BackgroundColor3 = Color3.fromHex("#ffffff")
    Knob.BorderSizePixel = 0
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local enabled = false
    local function updateVisual(state)
        enabled = state
        local bgColor = state and Color3.fromHex("#ffffff") or Color3.fromHex("#222222")
        local knobColor = state and Color3.fromHex("#151515") or Color3.fromHex("#ffffff")
        local knobPos = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
        TweenService:Create(SwitchFrame, FAST_TWEEN, {BackgroundColor3 = bgColor}):Play()
        TweenService:Create(Knob, FAST_TWEEN, {Position = knobPos, BackgroundColor3 = knobColor}):Play()
    end

    ToggleFrame.MouseButton1Click:Connect(function()
        enabled = not enabled
        updateVisual(enabled)
        callback(enabled)
    end)

    ToggleFrame.MouseEnter:Connect(function()
        TweenService:Create(ToggleFrame, FAST_TWEEN, {BackgroundColor3 = Color3.fromHex("#222222")}):Play()
    end)
    ToggleFrame.MouseLeave:Connect(function()
        TweenService:Create(ToggleFrame, FAST_TWEEN, {BackgroundColor3 = Color3.fromHex("#181818")}):Play()
    end)

    return {SetState = function(state) if state ~= enabled then enabled = state; updateVisual(state); callback(state) end end}
end

local function CreateSlider(name, icon, min, max, default, callback)
    local SliderFrame = Instance.new("Frame")
    SliderFrame.Size = UDim2.new(1, -20, 0, 80)
    SliderFrame.BackgroundColor3 = Color3.fromHex("#181818")
    SliderFrame.BorderSizePixel = 0
    SliderFrame.Parent = ScrollFrame
    Instance.new("UICorner", SliderFrame).CornerRadius = UDim.new(0, 12)

    local Label = Instance.new("TextLabel", SliderFrame)
    Label.Size = UDim2.new(1, -24, 0, 24)
    Label.Position = UDim2.new(0, 12, 0, 6)
    Label.BackgroundTransparency = 1
    Label.Text = icon .. "  " .. name
    Label.TextColor3 = Color3.fromHex("#ffffff")
    Label.TextSize = 14
    Label.Font = Enum.Font.Gotham
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local ValueLabel = Instance.new("TextLabel", SliderFrame)
    ValueLabel.Size = UDim2.new(0, 50, 0, 24)
    ValueLabel.Position = UDim2.new(1, -62, 0, 6)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = tostring(default)
    ValueLabel.TextColor3 = Color3.fromHex("#ffffff")
    ValueLabel.TextSize = 14
    ValueLabel.Font = Enum.Font.GothamBold
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local SliderBar = Instance.new("TextButton", SliderFrame)
    SliderBar.Size = UDim2.new(1, -24, 0, 6)
    SliderBar.Position = UDim2.new(0, 12, 0, 42)
    SliderBar.BackgroundColor3 = Color3.fromHex("#222222")
    SliderBar.BorderSizePixel = 0
    SliderBar.Text = ""
    SliderBar.AutoButtonColor = false
    Instance.new("UICorner", SliderBar).CornerRadius = UDim.new(1, 0)

    local Fill = Instance.new("Frame", SliderBar)
    Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromHex("#ffffff")
    Fill.BorderSizePixel = 0
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("TextButton", SliderBar)
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8)
    Knob.BackgroundColor3 = Color3.fromHex("#ffffff")
    Knob.BorderSizePixel = 0
    Knob.Text = ""
    Knob.AutoButtonColor = false
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function updateValue(input)
        local relPos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * relPos)
        ValueLabel.Text = tostring(val)
        Fill.Size = UDim2.new(relPos, 0, 1, 0)
        Knob.Position = UDim2.new(relPos, -8, 0.5, -8)
        callback(val)
    end

    Knob.MouseButton1Down:Connect(function() dragging = true end)
    SliderBar.MouseButton1Down:Connect(function()
        dragging = true
        updateValue({Position = Vector2.new(UserInputService:GetMouseLocation().X, 0)})
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateValue({Position = Vector2.new(input.Position.X, 0)})
        end
    end)
end

