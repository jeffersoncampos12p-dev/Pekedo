    sw.Position = UDim2.new(1, -56, 0.5, -12)
    sw.BackgroundColor3 = Color3.fromHex("#222222")
    sw.BorderSizePixel = 0
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)
    local kb = Instance.new("Frame", sw)
    kb.Size = UDim2.new(0, 20, 0, 20)
    kb.Position = UDim2.new(0, 2, 0.5, -10)
    kb.BackgroundColor3 = Color3.fromHex("#ffffff")
    kb.BorderSizePixel = 0
    Instance.new("UICorner", kb).CornerRadius = UDim.new(1, 0)
    local on = false
    local function upd(st)
        on = st
        TweenService:Create(sw, FAST_TWEEN, {BackgroundColor3 = st and Color3.fromHex("#ffffff") or Color3.fromHex("#222222")}):Play()
        TweenService:Create(kb, FAST_TWEEN, {Position = st and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10), BackgroundColor3 = st and Color3.fromHex("#151515") or Color3.fromHex("#ffffff")}):Play()
    end
    f.MouseButton1Click:Connect(function() on = not on; upd(on); callback(on) end)
    f.MouseEnter:Connect(function() TweenService:Create(f, FAST_TWEEN, {BackgroundColor3 = Color3.fromHex("#222222")}):Play() end)
    f.MouseLeave:Connect(function() TweenService:Create(f, FAST_TWEEN, {BackgroundColor3 = Color3.fromHex("#181818")}):Play() end)
    return {SetState = function(st) if st ~= on then on = st; upd(st); callback(st) end end}
end

local function CreateSlider(name, icon, min, max, default, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -20, 0, 80)
    f.BackgroundColor3 = Color3.fromHex("#181818")
    f.BorderSizePixel = 0
    f.Parent = ScrollFrame
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 12)
    local lbl = Instance.new("TextLabel", f)
    lbl.Size = UDim2.new(1, -24, 0, 24)
    lbl.Position = UDim2.new(0, 12, 0, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = icon .. "  " .. name
    lbl.TextColor3 = Color3.fromHex("#ffffff")
    lbl.TextSize = 14
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    local val = Instance.new("TextLabel", f)
    val.Size = UDim2.new(0, 50, 0, 24)
    val.Position = UDim2.new(1, -62, 0, 6)
    val.BackgroundTransparency = 1
    val.Text = tostring(default)
    val.TextColor3 = Color3.fromHex("#ffffff")
    val.TextSize = 14
    val.Font = Enum.Font.GothamBold
    val.TextXAlignment = Enum.TextXAlignment.Right
    local bar = Instance.new("TextButton", f)
    bar.Size = UDim2.new(1, -24, 0, 6)
    bar.Position = UDim2.new(0, 12, 0, 42)
    bar.BackgroundColor3 = Color3.fromHex("#222222")
    bar.BorderSizePixel = 0
    bar.Text = ""
    bar.AutoButtonColor = false
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromHex("#ffffff")
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    local knob = Instance.new("TextButton", bar)
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8)
    knob.BackgroundColor3 = Color3.fromHex("#ffffff")
    knob.BorderSizePixel = 0
    knob.Text = ""
    knob.AutoButtonColor = false
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local drag = false
    local function upd(input)
        local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local v = math.floor(min + (max - min) * rel)
        val.Text = tostring(v)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -8, 0.5, -8)
        callback(v)
    end
    knob.MouseButton1Down:Connect(function() drag = true end)
    bar.MouseButton1Down:Connect(function() drag = true; upd({Position = Vector2.new(UserInputService:GetMouseLocation().X, 0)}) end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
    UserInputService.InputChanged:Connect(function(input) if drag and input.UserInputType == Enum.UserInputType.MouseMovement then upd({Position = Vector2.new(input.Position.X, 0)}) end end)
end

