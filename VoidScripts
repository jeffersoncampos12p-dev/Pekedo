    lb.TextXAlignment = Enum.TextXAlignment.Left

    local vl = Instance.new("TextLabel", f)
    vl.Size = UDim2.new(0, 44, 0, 18)
    vl.Position = UDim2.new(1, -50, 0, 8)
    vl.BackgroundTransparency = 1
    vl.Text = tostring(def)
    vl.TextColor3 = Color3.fromHex(C.Acc)
    vl.TextSize = 12
    vl.Font = Enum.Font.GothamBold
    vl.TextXAlignment = Enum.TextXAlignment.Right

    local bar = Instance.new("TextButton", f)
    bar.Size = UDim2.new(1, -24, 0, 6)
    bar.Position = UDim2.new(0, 12, 0, 36)
    bar.BackgroundColor3 = Color3.fromHex(C.Hov)
    bar.BorderSizePixel = 0
    bar.Text = ""
    bar.AutoButtonColor = false
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", bar)
    fill.Size = UDim2.new((def - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromHex(C.Acc)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local kn = Instance.new("TextButton", bar)
    kn.Size = UDim2.new(0, 18, 0, 18)
    kn.Position = UDim2.new((def - min) / (max - min), -9, 0.5, -9)
    kn.BackgroundColor3 = Color3.fromHex(C.Text)
    kn.BorderSizePixel = 0
    kn.Text = ""
    kn.AutoButtonColor = false
    Instance.new("UICorner", kn).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function updateVal(inputX)
        local rel = math.clamp((inputX - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * rel)
        S[flag] = val
        vl.Text = tostring(val)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        kn.Position = UDim2.new(rel, -9, 0.5, -9)
        if cb then cb(val) end
    end

    kn.MouseButton1Down:Connect(function() dragging = true end)
    bar.MouseButton1Down:Connect(function()
        dragging = true
        updateVal(UserInputService:GetMouseLocation().X)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateVal(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
end

