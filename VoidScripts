-- ================== EXPANSÃO DO PARSER DE COMANDOS ==================
local oldParse = ParseCommand
ParseCommand = function(cmd)
    cmd = cmd:lower()
    local args = {}
    for word in cmd:gmatch("%S+") do table.insert(args, word) end
    if #args == 0 then return end
    local command = args[1]
    local value = tonumber(args[2]) or args[2]

    -- Novos comandos (adicionar à lista existente)
    if command == "longjump" then
        States.LongJump = value == "on" or value == true
    elseif command == "moonjump" then
        States.MoonJump = value == "on" or value == true
    elseif command == "autoswim" then
        States.AutoSwim = value == "on" or value == true
    elseif command == "autorun" then
        States.AutoRun = value == "on" or value == true
    elseif command == "antiknockback" then
        States.AntiKnockback = value == "on" or value == true
    elseif command == "antistun" then
        States.AntiStun = value == "on" or value == true
    elseif command == "antifire" then
        States.AntiFire = value == "on" or value == true
    elseif command == "antipoison" then
        States.AntiPoison = value == "on" or value == true
    elseif command == "infinitestamina" then
        States.InfiniteStamina = value == "on" or value == true
    elseif command == "nobreath" then
        States.NoBreath = value == "on" or value == true
    elseif command == "camshake" then
        States.CamShake = value == "on" or value == true
    elseif command == "lockcam" then
        States.LockCam = value == "on" or value == true
    elseif command == "firstperson" then
        States.FirstPerson = value == "on" or value == true
        if States.FirstPerson then
            Camera.CameraType = Enum.CameraType.Scriptable
            if LocalPlayer.Character then Camera.CameraSubject = LocalPlayer.Character:FindFirstChild("Head") end
        else
            Camera.CameraType = Enum.CameraType.Custom
        end
    elseif command == "thirdperson" then
        States.ThirdPerson = value == "on" or value == true
        if States.ThirdPerson then
            Camera.CameraType = Enum.CameraType.Custom
        end
    elseif command == "day" then
        Lighting:SetMinutesAfterMidnight(12 * 60)
    elseif command == "night" then
        Lighting:SetMinutesAfterMidnight(0)
    elseif command == "rain" then
        -- Precisa de partículas, simularemos com fog e som
        States.Rain = value == "on" or value == true
    elseif command == "snow" then
