    elseif command == "thirdperson" then States.ThirdPerson = value == "on" or value == true
    elseif command == "day" then Lighting:SetMinutesAfterMidnight(12*60)
    elseif command == "night" then Lighting:SetMinutesAfterMidnight(0)
