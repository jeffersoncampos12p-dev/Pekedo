local oldParseFinal = ParseCommand
ParseCommand = function(cmd)
    cmd = cmd:lower()
    local args = {}
    for word in cmd:gmatch("%S+") do table.insert(args, word) end
    if #args == 0 then return end
    local command = args[1]
    local value = tonumber(args[2]) or args[2]

    if finalCommands[command] then
        finalCommands[command](args[2])
    end
    oldParseFinal(cmd)
end

-- Loops finais (adicionar dentro do RenderStepped principal)
local finalLoops = function(char, humanoid, hrp)
    -- Características físicas
    if States.Headless and char:FindFirstChild("Head") then char.Head.Transparency = 1 end
    if States.NoArms then
        for _, limb in ipairs({"Left Arm", "Right Arm"}) do
            if char:FindFirstChild(limb) then char[limb].Transparency = 1 end
        end
    end
    if States.NoLegs then
        for _, limb in ipairs({"Left Leg", "Right Leg"}) do
            if char:FindFirstChild(limb) then char[limb].Transparency = 1 end
        end
    end
    if States.BigHead and char:FindFirstChild("Head") then char.Head.Size = Vector3.new(4,4,4) end
    if States.BigArms then
        for _, limb in ipairs({"Left Arm", "Right Arm"}) do
            if char:FindFirstChild(limb) then char[limb].Size = Vector3.new(4,2,2) end
        end
    end
    if States.SmallBody and char:FindFirstChild("HumanoidRootPart") then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "Head" then part.Size = part.Size * 0.8 end
        end
    end
    if States.RainbowBody then
        local hue = tick() % 1
        local color = Color3.fromHSV(hue, 1, 1)
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.Color = color end end
    end
    if States.Neon then
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.Material = Enum.Material.Neon end end
    end
    if States.Glow then
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.Material = Enum.Material.Glass; part.Reflectance = 1 end end
    end
    if States.FireAura then
        if not char:FindFirstChild("FireAura") then
            local fire = Instance.new("Fire", char:FindFirstChild("HumanoidRootPart"))
            fire.Name = "FireAura"
            fire.Heat = 25
            fire.Size = 10
        end
    else
        if char:FindFirstChild("FireAura") then char.FireAura:Destroy() end
    end
    if States.IceAura then
        if not char:FindFirstChild("IceAura") then
            local ice = Instance.new("ParticleEmitter", char:FindFirstChild("HumanoidRootPart"))
            ice.Name = "IceAura"
            ice.Texture = "rbxassetid://243098098"
            ice.Rate = 50
            ice.Lifetime = NumberRange.new(1, 2)
        end
    else
        if char:FindFirstChild("IceAura") then char.IceAura:Destroy() end
    end
    if States.ElectricAura then
        if not char:FindFirstChild("ElectricAura") then
            local spark = Instance.new("Sparkles", char:FindFirstChild("HumanoidRootPart"))
            spark.Name = "ElectricAura"
            spark.SparkleColor = Color3.new(1, 1, 0)
        end
    else
        if char:FindFirstChild("ElectricAura") then char.ElectricAura:Destroy() end
    end
    -- Auto Walk
    if States.AutoWalk then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid:Move(Vector3.new(0, 0, -1), true) end
    end
    -- Follow Mouse
    if States.FollowMouse and hrp then
        local target = Mouse.Hit.p
        local dir = (target - hrp.Position).Unit
        hrp.Velocity = dir * 50
    end
    -- Drone
    if States.Drone and hrp then
        local height = 20
        hrp.CFrame = CFrame.new(hrp.Position.X, height, hrp.Position.Z)
    end
end

