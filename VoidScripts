RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if S.Noclip then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    if S.Fly and hrp then
        local bv = hrp:FindFirstChild("FlyV"); local bg = hrp:FindFirstChild("FlyG")
        if bv and bg then
            local d = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then d += Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then d -= Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then d -= Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then d += Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then d += Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then d -= Vector3.new(0,1,0) end
            bv.Velocity = (d.Magnitude > 0 and d.Unit or Vector3.zero) * (S.FlySpeed or 50)
            bg.CFrame = CFrame.new(Vector3.zero, Camera.CFrame.LookVector)
        end
    end
    if S.Fling and hrp then hrp.Velocity = hrp.CFrame.LookVector * (S.FlingPower or 100); hrp.RotVelocity = Vector3.new(math.random(-20,20), math.random(-20,20), math.random(-20,20)) end
    if S.Invisible then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.Transparency = 0.7 end end end
    if S.GodMode or S.ForceField then
        if humanoid and humanoid.Health < humanoid.MaxHealth then humanoid.Health = humanoid.MaxHealth end
    elseif S.AutoHeal and humanoid and humanoid.Health < humanoid.MaxHealth then
        humanoid.Health = math.min(humanoid.Health + (S.HealAmount or 50) * 0.02, humanoid.MaxHealth)
    end
    if S.ForceFieldPart then S.ForceFieldPart.CFrame = hrp.CFrame end
    if S.Fullbright then Lighting.Ambient = Color3.new(1,1,1); Lighting.OutdoorAmbient = Color3.new(1,1,1) else Lighting.Ambient = Color3.new(0,0,0); Lighting.OutdoorAmbient = Color3.new(0.5,0.5,0.5) end
    if S.Fog then Lighting.FogEnd = 100 else Lighting.FogEnd = 10000 end
    if S.Aimbot and char then
        local n = nil; local md = 200
        for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") then local d = (Camera.CFrame.Position - p.Character.Head.Position).Magnitude; if d < md then md = d; n = p.Character.Head end end end
        if n then Camera.CFrame = CFrame.new(Camera.CFrame.Position, n.Position) end
    end
    if S.InfAmmo then
        local tools = {}
        if LocalPlayer.Backpack then for _, t in ipairs(LocalPlayer.Backpack:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end end
        if char then for _, t in ipairs(char:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end end
        for _, tool in ipairs(tools) do for _, attr in ipairs({"Ammo","CurrentAmmo","Magazine","Clip","Bullets"}) do local obj = tool:FindFirstChild(attr); if obj and obj:IsA("IntValue") then obj.Value = 999999999 end; if obj and obj:IsA("NumberValue") then obj.Value = 999999999 end end end
    end
    if S.Chams then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") and p.Transparency < 1 then p.Color = Color3.new(1,0,0) end end end
    if S.Wireframe then for _, p in ipairs(char:GetDescendants()) do if p:IsA("BasePart") then p.Wireframe = true end end end
    if S.XRay then for _, v in ipairs(Workspace:GetDescendants()) do if v:IsA("BasePart") and v.Transparency < 0.5 then v.Transparency = 0.8 end end end
    if S.Magneto and hrp then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj:IsDescendantOf(Workspace) then
                local dist = (hrp.Position - obj.Position).Magnitude
                if dist < 50 then obj.Velocity = (hrp.Position - obj.Position).Unit * (S.MagnetoForce or 500) end
            end
        end
    end

    -- Atualiza partes de aura (seguem o jogador)
    for _, part in ipairs(S.AuraParts) do if part and part.Parent then part.CFrame = hrp.CFrame end end

    -- Atualiza espadas
    if S.SwordParts and hrp then
        local speed = 2
        for _, data in ipairs(S.SwordParts) do
            if data.sword and data.sword.Parent then
                data.angle = data.angle + speed * 0.02
                local radius = 5
                local x = math.cos(data.angle) * radius
                local z = math.sin(data.angle) * radius
                data.sword.CFrame = hrp.CFrame * CFrame.new(x, math.sin(data.angle * 2) * 2, z) * CFrame.Angles(0, -data.angle, math.pi/4)
            end
        end
    end

    -- Atualiza WeaponParts
    if S.WeaponParts and hrp then
        for _, data in ipairs(S.WeaponParts) do
            if data.part and data.part.Parent then
                data.angle = (data.angle or 0) + 0.03
                local radius = 4
                local x = math.cos(data.angle) * radius
                local z = math.sin(data.angle) * radius
                data.part.CFrame = hrp.CFrame * CFrame.new(x, 0, z) * CFrame.Angles(0, data.angle, math.pi/2)
            end
        end
    end

    -- Atualiza ChainParts
    if S.ChainParts and hrp then
        for i, part in ipairs(S.ChainParts) do
            if part and part.Parent then
                local angle = tick() * 3 + i * (math.pi*2/#S.ChainParts)
                local radius = 3
                part.CFrame = hrp.CFrame * CFrame.new(math.cos(angle)*radius, math.sin(angle*2)*1.5, math.sin(angle)*radius)
            end
        end
    end

    -- Atualiza NoteParts
    if S.NoteParts and hrp then
        for _, data in ipairs(S.NoteParts) do
            if data.note and data.note.Parent then
                data.angle = (data.angle or 0) + 0.02
                local radius = 3
                local x = math.cos(data.angle) * radius
                local z = math.sin(data.angle) * radius
                data.note.CFrame = hrp.CFrame * CFrame.new(x, data.height + math.sin(tick()*2)*1.5, z)
            end
        end
    end
end)

