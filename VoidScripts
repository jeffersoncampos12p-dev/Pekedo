        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                plr.Character.HumanoidRootPart.Anchored = true
            end
        end
    elseif command == "freezeall" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                plr.Character.HumanoidRootPart.Anchored = true
            end
        end
    elseif command == "unfreezeall" then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                plr.Character.HumanoidRootPart.Anchored = false
            end
        end
    elseif command == "deleteall" then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Part") then v:Destroy() end
        end
    elseif command == "removedecals" then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Decal") then v:Destroy() end
        end
    end
    -- Continua com o parser antigo (caso o comando não tenha sido tratado)
    oldParse(cmd)
