local oldParse = ParseCommand
ParseCommand = function(cmd)
    cmd = cmd:lower()
    local args = {}
    for word in cmd:gmatch("%S+") do table.insert(args, word) end
    if #args == 0 then return end
    local command = args[1]
    local value = tonumber(args[2]) or args[2]

    if command == "longjump" then States.LongJump = value == "on" or value == true
    elseif command == "moonjump" then States.MoonJump = value == "on" or value == true
    elseif command == "autoswim" then States.AutoSwim = value == "on" or value == true
    elseif command == "autorun" then States.AutoRun = value == "on" or value == true
