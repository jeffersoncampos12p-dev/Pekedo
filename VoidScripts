                otherHrp.Velocity = Vector3.new(dir.X * 100, 50, dir.Z * 100)
            end
        end
    end
    if States.FakeLag then task.wait(States.LagAmount / 1000) end
    if States.TimeBomb and tick() > States.BombTime then
        for i = 1, 5 do
