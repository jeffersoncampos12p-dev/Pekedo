local function ClearAuras()
    for _, part in ipairs(S.AuraParts) do if part and part.Parent then part:Destroy() end end
    S.AuraParts = {}
    if S.SwordParts then for _, d in ipairs(S.SwordParts) do if d.sword and d.sword.Parent then d.sword:Destroy() end end S.SwordParts = nil end
    if S.WeaponParts then for _, d in ipairs(S.WeaponParts) do if d.part and d.part.Parent then d.part:Destroy() end end S.WeaponParts = nil end
    if S.ChainParts then for _, p in ipairs(S.ChainParts) do if p and p.Parent then p:Destroy() end end S.ChainParts = nil end
    if S.NoteParts then for _, n in ipairs(S.NoteParts) do if n.note and n.note.Parent then n.note:Destroy() end end S.NoteParts = nil end
    if S.AuraSound and S.AuraSound.Parent then S.AuraSound:Destroy() S.AuraSound = nil end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("PointLight") or obj:IsA("Sparkles") or obj:IsA("Beam") or obj.Name:find("Aura") then obj:Destroy() end
        end
    end
end

local function AddLight(color, range, brightness)
