    local function upd(st)
        on = st
        TweenService:Create(sw, TWEEN_FAST, {BackgroundColor3 = st and Color3.fromHex(C.Acc) or Color3.fromHex(C.Hov)}):Play()
        TweenService:Create(kn, TWEEN_FAST, {Position = st and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10), BackgroundColor3 = st and Color3.fromHex(C.Bg) or Color3.fromHex(C.Text)}):Play()
